{
  "appId": "com.ultron.commandcenter",
  "productName": "ULTRON",
  "copyright": "Copyright © 2026 ULTRON Architecture",
  "directories": {
    "output": "dist-desktop",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "dist-electron/main.js"
  },
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ],
    "artifactName": "ULTRON-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": false,
    "deleteAppDataOnUninstall": true
  }
}
