# ==============================================================================
# PROJECT ULTRON - ENVIRONMENT CONFIGURATION BLUEPRINT
# SDS Version: 2.0
# Security Requirement: ZERO HARDCODED SECRETS IN SOURCE CODE
# ==============================================================================

# Core Application Settings
ULTRON_ENV=development
ULTRON_DEBUG=true
ULTRON_SECRET_KEY=
ULTRON_API_PREFIX=/api/v1
ULTRON_HOST=0.0.0.0
ULTRON_PORT=8000

# CORS Configuration (Comma-separated origins)
ULTRON_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Security & Encryption (Fernet 32-byte url-safe base64 key)
ULTRON_MEMORY_ENCRYPTION_KEY=

# JWT Authentication
ULTRON_JWT_ALGORITHM=HS256
ULTRON_ACCESS_TOKEN_EXPIRE_MINUTES=15
ULTRON_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16 with asyncpg)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ultron_db
DATABASE_URL=

# Redis Cache & Event Bus
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=

# ChromaDB Vector Store
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_PERSIST_DIRECTORY=./chroma_data

# AI Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Logging & Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
OPENTELEMETRY_ENDPOINT=
